# Project Codex — environment variables
# Copy this file to .env and fill in your values.

DRUGBANK_API_KEY=
DRUGBANK_API_BASE=https://api.drugbank.com/discovery/v1
DRUGBANK_RELEASE=API

ICD_CLIENT_ID=
ICD_CLIENT_SECRET=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DB=neo4j

RATE_LIMIT_RPM=100
LOG_LEVEL=INFO
FORCE=1

# Authentication: set a private signing key for deployed environments.
JWT_SECRET_KEY=
# Optional first administrator bootstrap; both values must be supplied.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Language packs demo loading (set to false to start with an empty database)
LOAD_DEMO_DATA=true
